{
  "functions": {
    "api/generar-uri-x25519.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 30, "includeFiles": "document/**"},
    "api/job.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10},
    "api/upload-signed.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 30},
    "api/list-signed.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10},
    "api/download-signed.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 15},
    "api/list-pdfs.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10, "includeFiles": "document/**"},
    "api/clear-signed.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10},
    "api/download.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 15, "includeFiles": "document/**"},
    "api/register-key.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10},
    "api/list-keys.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10},
    "api/delete-key.php": {"runtime": "vercel-php@0.7.4", "maxDuration": 10}
  },
  "rewrites": [
    {"source": "/integracion", "destination": "/integracion.html"},
    {"source": "/api/job/([^/]+)", "destination": "/api/job.php?job=$1"}
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, DELETE"},
        {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Job-Id, X-API-KEY"}
      ]
    }
  ]
}